{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/eos_state.schema.json",
  "title": "EOS Operational State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "created_at_utc",
    "updated_at_utc",
    "timezone",
    "sources",
    "energy_profile",
    "planning_policy",
    "task_annotations",
    "habits",
    "habit_log",
    "review_state",
    "escalation_policy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "created_at_utc": {
      "$ref": "#/$defs/dateTime"
    },
    "updated_at_utc": {
      "$ref": "#/$defs/dateTime"
    },
    "timezone": {
      "const": "Europe/Berlin"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar_primary_source",
        "tasks_primary_source",
        "current_task_transition_source",
        "routines_source",
        "profile_source",
        "memory_pointer"
      ],
      "properties": {
        "calendar_primary_source": {
          "const": "Google Calendar"
        },
        "tasks_primary_source": {
          "const": "Google Tasks"
        },
        "current_task_transition_source": {
          "const": "data/tasks.json"
        },
        "routines_source": {
          "const": "data/routines.json"
        },
        "profile_source": {
          "const": "data/profile.json"
        },
        "memory_pointer": {
          "const": "MEMORY.md"
        }
      }
    },
    "energy_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_daily_windows",
        "workday_note"
      ],
      "properties": {
        "default_daily_windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/energyWindow"
          }
        },
        "workday_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "planning_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wake_window",
        "buffer_ratio",
        "collision_order",
        "deep_work",
        "behavior_rules"
      ],
      "properties": {
        "wake_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/time"
            },
            "end": {
              "$ref": "#/$defs/time"
            }
          }
        },
        "buffer_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "collision_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "kind"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "deep_work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_duration_min",
            "default_focus_min",
            "default_break_min",
            "preferred_blocks_per_day",
            "max_blocks_per_day"
          ],
          "properties": {
            "min_duration_min": {
              "type": "integer",
              "minimum": 1
            },
            "default_focus_min": {
              "type": "integer",
              "minimum": 1
            },
            "default_break_min": {
              "type": "integer",
              "minimum": 0
            },
            "preferred_blocks_per_day": {
              "type": "integer",
              "minimum": 0
            },
            "max_blocks_per_day": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "behavior_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "task_annotations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/taskAnnotation"
      }
    },
    "habits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/habit"
      }
    },
    "habit_log": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/habitLogEntry"
      }
    },
    "review_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_daily_review_date",
        "last_weekly_review_date",
        "review_pending",
        "open_review_questions"
      ],
      "properties": {
        "last_daily_review_date": {
          "$ref": "#/$defs/dateOrNull"
        },
        "last_weekly_review_date": {
          "$ref": "#/$defs/dateOrNull"
        },
        "review_pending": {
          "type": "boolean"
        },
        "open_review_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "escalation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overdue_tasks",
        "deferred_tasks",
        "missing_task_metadata"
      ],
      "properties": {
        "overdue_tasks": {
          "$ref": "#/$defs/escalationRule"
        },
        "deferred_tasks": {
          "$ref": "#/$defs/escalationRule"
        },
        "missing_task_metadata": {
          "$ref": "#/$defs/escalationRule"
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dateOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "dateTimeOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "energy": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "energyRequirement": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "energyWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "start",
        "end",
        "energy"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        },
        "energy": {
          "$ref": "#/$defs/energy"
        }
      }
    },
    "escalationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "action"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "habit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "frequency",
        "target_time",
        "routine_ref",
        "minimum_version",
        "full_version",
        "collision_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "paused"
          ]
        },
        "frequency": {
          "enum": [
            "daily",
            "weekly"
          ]
        },
        "target_time": {
          "$ref": "#/$defs/time"
        },
        "routine_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "minimum_version": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "full_version": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "collision_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on_calendar_conflict",
            "on_task_conflict"
          ],
          "properties": {
            "on_calendar_conflict": {
              "const": "preserve_minimum_version"
            },
            "on_task_conflict": {
              "const": "preserve_minimum_version"
            }
          }
        },
        "type": {
          "enum": [
            "build",
            "reduce",
            "maintain",
            "recovery"
          ]
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "replacement_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recovery_rule": {
          "type": "object",
          "additionalProperties": true
        },
        "trigger_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/time"
            },
            "end": {
              "$ref": "#/$defs/time"
            }
          }
        }
      }
    },
    "habitLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_done",
        "streak",
        "missed_dates",
        "updated_at_utc"
      ],
      "properties": {
        "last_done": {
          "$ref": "#/$defs/dateTimeOrNull"
        },
        "streak": {
          "type": "integer",
          "minimum": 0
        },
        "missed_dates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/date"
          }
        },
        "updated_at_utc": {
          "$ref": "#/$defs/dateTimeOrNull"
        }
      }
    },
    "priority": {
      "enum": [
        "P1",
        "P2",
        "P3",
        "untriaged"
      ]
    },
    "taskAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "energy_required",
        "estimated_minutes",
        "priority_source",
        "last_reviewed_at",
        "triage_status"
      ],
      "properties": {
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "energy_required": {
          "$ref": "#/$defs/energyRequirement"
        },
        "estimated_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "priority_source": {
          "enum": [
            "explicit",
            "user",
            "missing",
            "inferred_deadline",
            "inferred_list",
            "legacy_stub"
          ]
        },
        "last_reviewed_at": {
          "$ref": "#/$defs/dateTimeOrNull"
        },
        "triage_status": {
          "enum": [
            "ready",
            "needs_triage"
          ]
        }
      }
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    }
  }
}
