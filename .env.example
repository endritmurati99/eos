# Example environment only.
# Never commit credentials, tokens, API keys, OAuth client secrets, or real account IDs.
# Copy to .env locally and keep real values outside git.

# Runtime networking
PORT=18789
COMPOSE_PROJECT_NAME=openclaw
TRAEFIK_HOST=example.com

# Telegram bot tokens
OPENCLAW_TELEGRAM_BOT_TOKEN_DEFAULT=<placeholder-never-commit-real-token>
OPENCLAW_TELEGRAM_BOT_TOKEN_PERSONAL_ASSISTANT=<placeholder-never-commit-real-token>
OPENCLAW_TELEGRAM_BOT_TOKEN_PHAROS=<placeholder-never-commit-real-token>
OPENCLAW_TELEGRAM_BOT_TOKEN_SOLARA=<placeholder-never-commit-real-token>
OPENCLAW_TELEGRAM_BOT_TOKEN_PHOTON=<placeholder-never-commit-real-token>
OPENCLAW_TELEGRAM_BOT_TOKEN_AURELIUS=<placeholder-never-commit-real-token>
OPENCLAW_TELEGRAM_BOT_TOKEN_LUX=<placeholder-never-commit-real-token>

# OpenClaw gateway/auth tokens
OPENCLAW_GATEWAY_TOKEN=<placeholder-never-commit-real-token>
OPENCLAW_HOOKS_TOKEN=<placeholder-never-commit-real-token>

# Google live readiness gates default to disabled.
EOS_GOG_BIN=gog
EOS_GOOGLE_ACCOUNT=<google-account-email-placeholder>
EOS_GOOGLE_CREDENTIALS_PATH=<path-outside-repo-placeholder>
EOS_GOOGLE_TOKEN_PATH=<path-outside-repo-placeholder>
EOS_GOOGLE_TASKS_ENABLED=false
EOS_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
EOS_GMAIL_MAX_RESULTS=50
EOS_GMAIL_READONLY_ENABLED=false
EOS_DRIVE_READONLY_ENABLED=false
EOS_MAPS_ROUTES_ENABLED=false
EOS_GOOGLE_LIVE_E2E_ENABLED=false
