[Unit]
Description=EOS scheduled job %i
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/docker/openclaw-qt6t
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/docker compose exec -T -w /data/.openclaw/workspaces/personal-assistant openclaw .venv/bin/python -m src.eos_cli --json-only run-job %i --no-dry-run --send
